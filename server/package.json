{
  "name": "@planipus/server",
  "version": "0.0.0",
  "private": true,
  "description": "Clean-room Planipus Server calendar synchronization service",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/src/commands/migrate.js",
    "seed:fake": "node dist/src/commands/seed-fake.js",
    "start:api": "node dist/src/commands/api.js",
    "start:scheduler": "node dist/src/commands/scheduler.js",
    "start:worker": "node dist/src/commands/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.0",
    "@fastify/swagger": "9.8.1",
    "@planipus/calendar-sync": "file:../packages/calendar-sync",
    "fastify": "5.10.0",
    "google-auth-library": "10.9.0",
    "kysely": "0.29.0",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "fast-check": "4.2.0",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
