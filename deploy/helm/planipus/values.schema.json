{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "process",
    "existingSecret",
    "config",
    "postgresql",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "process": {
      "type": "object",
      "required": ["api", "scheduler", "worker"],
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "scheduler": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 }
      }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "required": [
        "publicUrl",
        "providerMode",
        "masterKeyId",
        "sessionTtlSeconds",
        "schedulerIntervalMs",
        "workerIntervalMs",
        "jobLeaseSeconds",
        "migrationAttempts"
      ],
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^https://[^/?#]+$"
        },
        "providerMode": {
          "type": "string",
          "enum": ["fake", "google"]
        },
        "masterKeyId": { "type": "string", "minLength": 1 },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 604800
        },
        "schedulerIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "workerIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "jobLeaseSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "migrationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "size", "accessModes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClassName": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "existingAdminSecret", "image", "database", "adminUsername", "username", "dataPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingAdminSecret": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "adminUsername": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "dataPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
