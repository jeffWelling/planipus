{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planipus.org/schema/calendar-sync/v1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "cases"],
  "properties": {
    "contract_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "kind", "path", "requirements"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"},
          "kind": {"enum": ["hours_evaluation", "policy_evaluation", "validation"]},
          "path": {"type": "string", "pattern": "^cases/[a-z0-9_/-]+\\.json$"},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(CAL|MAC)-[0-9]{3}$"}
          }
        }
      }
    }
  }
}
