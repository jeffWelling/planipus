{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planipus.org/schema/calendar-sync/v1/case-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "defaults", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"const": 1},
    "kind": {"enum": ["hours_evaluation", "policy_evaluation", "validation"]},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": {"input": {"type": "object"}}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "title", "requirements", "input_patch", "expected"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"},
          "title": {"type": "string", "minLength": 1},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "input_patch": {"type": "object"},
          "expected": {"type": "object"}
        }
      }
    }
  }
}
