{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planipus.org/schema/calendar-sync/v1/registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "contract_version": {"const": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string"}}
      }
    }
  }
}
