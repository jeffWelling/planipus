# Development-only example. Copy to .env, then replace every value marked CHANGE_ME.
NODE_ENV=development
PLANIPUS_HOST=127.0.0.1
PLANIPUS_PORT=8080
PLANIPUS_PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://planipus:CHANGE_ME@127.0.0.1:5432/planipus

# Generate 32 random bytes and base64-encode them. Never reuse this example key.
PLANIPUS_MASTER_KEY=CHANGE_ME
PLANIPUS_MASTER_KEY_ID=local-v1
PLANIPUS_BOOTSTRAP_TOKEN=CHANGE_ME
PLANIPUS_COOKIE_SECURE=false
PLANIPUS_SESSION_TTL_SECONDS=43200
PLANIPUS_MIGRATIONS_DIR=server/migrations
PLANIPUS_MIGRATION_ATTEMPTS=30

# Start safely against the deterministic local provider. Change to google only
# after creating a Google web OAuth client and filling in both credentials.
PLANIPUS_PROVIDER_MODE=fake
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google writes for availability fences and Smart Meetings remain behind an
# explicit experimental gate until the live invitation lifecycle suite passes.
PLANIPUS_EXPERIMENTAL_GOOGLE_PLANNING=false

PLANIPUS_SCHEDULER_INTERVAL_MS=15000
PLANIPUS_WORKER_INTERVAL_MS=1000
PLANIPUS_JOB_LEASE_SECONDS=60
