{
  "name": "planipus",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, self-hosted bridge between independent calendars.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/calendar-sync",
    "server",
    "web"
  ],
  "scripts": {
    "build": "node scripts/workspace-command.mjs build",
    "typecheck": "node scripts/workspace-command.mjs typecheck",
    "test": "node scripts/workspace-command.mjs test",
    "verify": "node scripts/node-gate.mjs",
    "gate": "./scripts/gate.sh",
    "provenance": "node scripts/provenance-gate.mjs",
    "docs": "node scripts/docs-gate.mjs",
    "dev:server": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "seed:fake": "node --env-file-if-exists=.env server/dist/src/commands/seed-fake.js",
    "dev:web": "npm run dev --workspace @planipus/web"
  }
}
